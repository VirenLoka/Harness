# Live endpoint URL, ngrok token and API key. Never commit this.
listen.md

# Upstream repositories, fetched by scripts/setup_models.sh rather than
# vendored. Cloning them at a pinned commit keeps roughly 2.5 GB of code and
# weights out of this repository and its LFS quota, and several of them carry
# their own weights in their own git history -- Pro-GAT has 244 MB of
# checkpoints as ordinary tracked files, and REINVENT4 still has its deleted
# priors recoverable from an earlier commit. Each also has its own .git, which
# git would otherwise record as a broken gitlink that clones empty.
/Pro-GAT/
/DiffLinker/
/REINVENT4/
/Linker-GPT/

# Fetched model weights, in case any of those directories is ever vendored
# after all. REINVENT4's priors alone are ~2 GB.
DiffLinker/models/
REINVENT4/priors/

# macOS
.DS_Store

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
.env

# Testing & linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime generated files
run/
*.log
endpoint.json

# Conda / Docker artifacts
.conda-dock/

# IDE
.vscode/
.idea/


# Generated by protacbench: samples, SDF conversions, reports, repair results,
# the harness patch, and logs. All reproducible from a run.
protacbench/runs/

# Generated by adclinker: warheads, configs, samples, reports, the
# reference profile cache. All reproducible from a run.
adclinker/runs/

# The same protacbench run outputs as above, written to the repository root
# rather than under protacbench/runs/. Batch CSVs from a repair sweep, the
# merged views built from them, and the task lists that drove them. Every one
# is reproducible from `assess` and `repair`, so the rule above applies --
# it just never matched these because of where they landed.
/repair_batch_*.csv
/repair_master*.csv
/repair_tasks.jsonl
/repair_summary.md
/final_*.csv
/progress_report_*.md
/tasks_*.jsonl
