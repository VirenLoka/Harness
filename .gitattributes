# Large binaries go through Git LFS when they are tracked here at all.
#
# Most model weights are NOT tracked in this repository: Pro-GAT and
# DiffLinker are fetched by scripts/setup_models.sh from their own upstreams,
# which already carry their checkpoints. These patterns cover what is left,
# chiefly DiffSBDD's data archive, and catch any checkpoint deliberately added
# later so it never lands as a raw blob.
*.tar.gz  filter=lfs diff=lfs merge=lfs -text
*.ckpt    filter=lfs diff=lfs merge=lfs -text
*.pt      filter=lfs diff=lfs merge=lfs -text
*.pth     filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Shell scripts keep LF endings so they run after a checkout on any host.
*.sh text eol=lf
